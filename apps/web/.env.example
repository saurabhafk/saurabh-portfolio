# Production (Vercel): leave NEXT_PUBLIC_API_URL unset so the widget calls same-origin /api/chat
# Local Express+Ollama override:
# NEXT_PUBLIC_API_URL=http://localhost:4000

# Required for Next.js /api/chat and for `npm run build:index`
GEMINI_API_KEY=

# Optional
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_CHAT_MODEL=gemini-flash-lite-latest
# RELEVANCE_THRESHOLD=0.35
